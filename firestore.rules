rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for the catalog, allow updates from authenticated users or client admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /tiktok_videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
